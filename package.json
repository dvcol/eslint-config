{
  "name": "@dvcol/eslint-config",
  "type": "module",
  "version": "1.8.0",
  "packageManager": "pnpm@10.8.1",
  "description": "Sharable eslint configs",
  "author": "dvcol",
  "license": "MIT",
  "homepage": "https://github.com/dvcol/eslint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvcol/eslint-config.git"
  },
  "bugs": "https://github.com/dvcol/eslint-config/issues",
  "keywords": [
    "typescript",
    "library",
    "eslint-config"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "*.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">= 8"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsdown && publint",
    "watch": "npm run build -- --watch lib",
    "lint": "eslint lib",
    "lint:fix": "eslint lib --fix",
    "lint:package": "publint",
    "test:unit": "vitest --run --coverage --pass-with-no-tests",
    "test:watch": "vitest",
    "release": "standard-version",
    "release:changelog": "extract-changelog-release > RELEASE.md"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@prettier/plugin-xml": ">= 3.4.0",
    "eslint": ">= 9.2.0",
    "eslint-plugin-format": ">= 1.0.0",
    "prettier": ">= 3.5.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-svelte": {
      "optional": true
    },
    "eslint-plugin-vuejs-accessibility": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "chalk": "^5.6.2",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.1.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "extract-changelog-release": "^1.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.18",
    "standard-version": "^9.5.0",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,vue,svelte,json,md,yml,html,md,svg,xml}": [
      "eslint --fix"
    ]
  }
}
